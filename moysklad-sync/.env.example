# Мой Склад API — один из двух вариантов:
# Вариант 1: токен из раздела Настройки → Онлайн-торговля → Токены (созданный вами токен)
MOYSKLAD_TOKEN=a041316522655b941c00ff988d92f64ccd9ff5e9
# Вариант 2: логин + пароль приложения (Настройки пользователя → Безопасность)
# MOYSKLAD_LOGIN=your@email.com
# MOYSKLAD_PASSWORD=пароль_приложения

# Saleor GraphQL
# Локальный тест (API Saleor на этой машине) — тогда креды admin@example.com подойдут:
#   SALEOR_GRAPHQL_URL=http://localhost:8000/graphql/
# Продакшен:
#   SALEOR_GRAPHQL_URL=https://miraflores-shop.com/graphql/
SALEOR_GRAPHQL_URL=https://miraflores-shop.com/graphql/

# Staff-пользователь Saleor (для локального теста — те же, что и вход в дашборд)
SALEOR_STAFF_EMAIL=admin@example.com
SALEOR_STAFF_PASSWORD=admin12345

# Опционально: путь к файлу лога (по умолчанию moysklad-sync.log в текущей папке)
# MOYSKLAD_SYNC_LOG=/var/log/moysklad-sync.log

# --- Webhook Saleor → МС (реализация при отгрузке) ---
# Порт сервера вебхуков (по умолчанию 3300)
# WEBHOOK_PORT=3300
# Файл для защиты от дублей: order/fulfillment → demand (по умолчанию moysklad-fulfillments.json в папке moysklad-sync)
# MOYSKLAD_DEDUP_FILE=/var/lib/moysklad-fulfillments.json
