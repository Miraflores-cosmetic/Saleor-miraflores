[Unit]
Description=Miraflores Nest API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/miraflores/backend
EnvironmentFile=/opt/miraflores/backend/.env
ExecStart=/usr/bin/node dist/main
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
