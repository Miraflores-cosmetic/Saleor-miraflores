# Скопировать в deploy/deploy.env (не коммитить).
# deploy/deploy.env в .gitignore если добавите git в монорепо.

DEPLOY_HOST=root@91.229.8.83
DEPLOY_PATH=/opt/miraflores
DEPLOY_BRANCH=main

# VPS rsync/ssh (работает root@91.229.8.83)
DEPLOY_SSH_KEY=~/.ssh/id_ed25519_mira_ap

# Git push keys (отдельные):
# Front → Front-end-site (mira-ap)
FRONT_GIT_PUSH_KEY=~/.ssh/id_ed25519_mira_ap
# Mono → Back-miraflores (deploy key; SSH config Host github.com-back)
MONO_GIT_PUSH_KEY=~/.ssh/id_ed25519_deploy

# Куда nginx отдаёт Vite static
FRONT_STATIC_DIR=/var/www/miraflores-front

# Front git remote (отдельный репозиторий)
FRONT_GIT_REMOTE=git@github.com:Miraflores-cosmetic/Front-end-site.git

# Монорепо backend + Admin + packages (без Front/)
MONO_GIT_REMOTE=git@github.com:Miraflores-cosmetic/Back-miraflores.git

# Яндекс.Карты — попадает в Vite bundle при npm run build
DEPLOY_YANDEX_MAP_API_KEY=
